{
  "manifest_version": 3,
  "name": "DSH Browser",
  "version": "0.1.0",
  "description": "Browser automation for DeepSeek Harness (dsh)",
  "minimum_chrome_version": "116",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "DSH Browser",
    "default_icon": { "128": "icons/icon-128.png" }
  },
  "icons": { "128": "icons/icon-128.png" },
  "side_panel": { "default_path": "sidepanel.html" },
  "options_page": "options.html",
  "commands": {
    "toggle-side-panel": {
      "suggested_key": { "default": "Ctrl+Shift+U" },
      "description": "Toggle the DSH Browser side panel"
    }
  },
  "content_scripts": [
    {
      "js": ["content-dom.js"],
      "matches": ["<all_urls>"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "js": ["content-indicator.js"],
      "matches": ["<all_urls>"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "sidePanel",
    "storage",
    "scripting",
    "debugger",
    "tabs",
    "tabGroups",
    "alarms",
    "notifications",
    "offscreen",
    "unlimitedStorage",
    "nativeMessaging"
  ],
  "host_permissions": ["<all_urls>"]
}
